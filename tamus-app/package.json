{
  "name": "tamus-app",
  "version": "0.1.0",
  "description": "Настольный редактор процессов и классификаторов Tamus",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "node --test tests",
    "test:ui": "node scripts/preview-smoke.cjs",
    "format": "prettier --write src scripts tests README.md src-tauri/tauri.conf.json src-tauri/capabilities",
    "format:check": "prettier --check src scripts tests README.md src-tauri/tauri.conf.json src-tauri/capabilities",
    "test:idef0": "node scripts/idef0-smoke.cjs",
    "test:ramus": "node scripts/ramus-workflow.cjs",
    "test:shell": "node scripts/shell-dfd-smoke.cjs",
    "test:i18n": "node scripts/i18n-smoke.cjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~7.0.2",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "npm@9.2.0"
}
